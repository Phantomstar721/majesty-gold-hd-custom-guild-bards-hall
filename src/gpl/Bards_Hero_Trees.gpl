// Private bard decision trees. Common travel/task completion remains stock.

// Stock Healer decision order; only the approved bard activities remain.
function Bards_Troubadour_Tree (agent thisagent)

declare

begin

	if ($Bards_Hire_Guard(ThisAgent)) return;
	if ($Bards_Renown_Return(ThisAgent)) return;

	$createeffector(thisagent,"thought_bubble_think",#think_bubble_time);
	$SpecifyIntent (ThisAgent, #Intent_Thinking);

	if ($check_nearby(thisagent) == False)

	if ($Check_rewards(thisagent,TRUE) == False)

	if ($Defend_home(thisagent) == False)

	if ($rest(thisagent) == False)

	if ($Bards_Follow_Check(ThisAgent, "Spellsinger", 60) == FALSE)

	if ($Bards_Follow_Check(ThisAgent, "Hero", 100) == FALSE)

	if ($Purchase_equipment(thisagent) == False)

	if ($Purchase_bazaar(thisagent, 70) == False)

	if ($Visit_Building(ThisAgent, "Inn", 10) == False)

	if ($Visit_Building(ThisAgent, "Royal_gardens", 20) == False)

	if ($check_library(thisagent,35, "Train_magic_resist") == FALSE)

	if ($Go_home(thisagent,30) == False)

		begin
			$SpecifyIntent (ThisAgent, #intent_wandering);
			thisagent's "counter" = 0;
			thisagent's "activescript" = $hero_wander;
		end

end

// Stock Cultist modules plus Wizard exploration; work precedes optional leisure.
function Bards_Spellsinger_Tree (agent thisagent)

declare

begin

	$Bards_Street_Service(ThisAgent);

	if ($Bards_Hire_Guard(ThisAgent)) return;

	$createeffector(thisagent,"thought_bubble_think",#think_bubble_time);
	$SpecifyIntent (ThisAgent, #Intent_Thinking);

	if ($check_nearby(thisagent) == False)

	if ($Check_rewards(thisagent,FALSE) == False)

	if ($Defend_home(thisagent) == False)

	if ($rest(thisagent) == False)

	if ($Purchase_equipment(thisagent) == False)

	if ($Purchase_bazaar(thisagent, 70) == False)

	if ($Bards_Street_Check(ThisAgent) == FALSE)

	if ($Bards_combat_wandering(thisagent,50) == False)

	if ($Bards_combat_wandering_heroes(thisagent,50) == False)

	if ($collect_special_item (ThisAgent, 45) == False)

	if ($Raid_lair(thisagent,20) == False)

	if ($explore_map(thisagent,80) == False)

	if ($Visit_Building(ThisAgent, "Royal_gardens", 20) == False)

	if ($check_library(thisagent,25, "Train_magic_resist") == FALSE)

	if ($check_library(thisagent,30, "Learn_generic_spell") == FALSE)

	if ($raid_enemy_building(thisagent,20) == False)

	if ($pursue_entertainment(thisagent) == False)

	if ($Go_home(thisagent,15) == False)

		begin
			$SpecifyIntent (ThisAgent, #intent_wandering);
			thisagent's "counter" = 0;
			thisagent's "activescript" = $Bards_Spellsinger_Wander;
		end

end

// Stock Ranger decisions, with private nearest viable hunts before exploration.
function Bards_Blade_Dancer_Tree (agent thisagent)

declare

begin

	if ($Bards_Hire_Guard(ThisAgent)) return;

	$createeffector(thisagent,"thought_bubble_think",#think_bubble_time);
	$SpecifyIntent (ThisAgent, #Intent_Thinking);

	if ($check_nearby(thisagent) == False)

	if ($Check_rewards(thisagent,FALSE) == False)

	if ($Defend_home(thisagent) == False)


	if ($rest(thisagent) == False)

	if ($Purchase_equipment(thisagent) == False)

	if ($Purchase_bazaar(thisagent, 70) == False)

	if ($pursue_entertainment(thisagent) == False)



	if ($Hall_Champs_Check(thisagent, 40) == False)

	// Occasionally choose a nearby town venue before leaving on an ordinary hunt.
	if ($Bards_Prize_Duel_Check(thisagent,25) == FALSE)

	// Prefer nearby viable duels over stock Ranger exploration.
	if ($Bards_combat_wandering(thisagent,95) == False)

	if ($Bards_combat_wandering_heroes(thisagent,55) == False)

	if ($explore_map(thisagent,95) == false)





// if ($Heal_another(thisagent,80) == False)


	if ($Go_home(thisagent,15) == False)

	if ($check_library(thisagent,15, "Train_magic_resist") == FALSE)

	if ($check_library(thisagent,30, "Learn_generic_spell") == FALSE)

	if ($Raid_lair(thisagent,15) == False)

	if ($raid_enemy_building(thisagent,10) == False)

	if ($Visit_Building(ThisAgent, "Royal_gardens", 30) == False)

	if ($Visit_Building(ThisAgent, "Inn", 15) == False)
		begin
			$SpecifyIntent (ThisAgent, #intent_wandering);
			thisagent's "counter" = 0;
			thisagent's "activescript" = $Bards_Dancer_Wander;
		end

end
